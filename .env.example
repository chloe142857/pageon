# Supabase Dashboard > Project Settings > API에서 가져옵니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용입니다. 브라우저에 노출하거나 NEXT_PUBLIC_ 접두어를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 서술형 의미 채점용 서버 전용 환경 변수입니다. 둘 다 입력할 때만 AI 채점을 호출합니다.
# 실제 키는 .env.local에만 저장하고, 브라우저에 노출하는 NEXT_PUBLIC_ 접두어를 사용하지 마세요.
OPENAI_API_KEY=
OPENAI_GRADING_MODEL=
