# Supabase Dashboard > Project Settings > API에서 가져옵니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용입니다. 브라우저에 노출하거나 NEXT_PUBLIC_ 접두어를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# Upstage Solar 서술형 의미 채점용 서버 전용 환경 변수입니다.
# 실제 키는 .env.local에만 저장하고, 브라우저에 노출하는 NEXT_PUBLIC_ 접두어를 사용하지 마세요.
UPSTAGE_API_KEY=
UPSTAGE_API_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_GRADING_MODEL=solar-pro4
# 기본 모델이 일시 제한·서버 오류·입력 토큰 한도 오류로 실패할 때 순서대로 재시도합니다.
UPSTAGE_GRADING_FALLBACK_MODELS=solar-pro3,solar-mini4
